# 1. Entradas de dados
renda = float(input("Informe sua renda mensal: R$ "))

# Primeira despesa
escolha1 = int(input("Escolha o gasto 1 (1-Alimentação / 2-Transporte / 3-Lazer / 4-Saúde / 5-Outros): "))
valor_gasto1 = float(input("Quanto você gastou com sua primeira despesa? R$ "))

# Segunda despesa
escolha2 = int(input("Escolha o gasto 2 (1-Alimentação / 2-Transporte / 3-Lazer / 4-Saúde / 5-Outros): "))
valor_gasto2 = float(input("Quanto você gastou com sua segunda despesa? R$ "))

# 2. Definição da Primeira Categoria
if escolha1 == 1:
    categoria1 = "Alimentação"
elif escolha1 == 2:
    categoria1 = "Transporte"
elif escolha1 == 3:
    categoria1 = "Lazer"
elif escolha1 == 4:
    categoria1 = "Saúde"
elif escolha1 == 5:
    categoria1 = "Outros"
else:
    categoria1 = "Inválida"

# 3. Definição da Segunda Categoria
if escolha2 == 1:
    categoria2 = "Alimentação"
elif escolha2 == 2:
    categoria2 = "Transporte"
elif escolha2 == 3:
    categoria2 = "Lazer"
elif escolha2 == 4:
    categoria2 = "Saúde"
elif escolha2 == 5:
    categoria2 = "Outros"
else:
    categoria2 = "Inválida"

# 4. Cálculos
soma_gastos = valor_gasto1 + valor_gasto2
financeiro = renda - soma_gastos

# 5. Exibição do Resumo
print("\n" + "-" * 40)
print("          CONSULTA FINANCEIRA          ")
print("-" * 40)
print(f"Renda inicial:          R$ {renda:.2f}")
print(f"Gasto 1 ({categoria1}): R$ {valor_gasto1:.2f}")
print(f"Gasto 2 ({categoria2}): R$ {valor_gasto2:.2f}")
print(f"Total com gastos:       R$ {soma_gastos:.2f}")
print(f"Saldo do mês:           R$ {financeiro:.2f}")
print("-" * 40)

# 6. Avaliação do saldo
match financeiro:
    case valor if valor >= 7000:
        print("Status: Seu saldo final está excelente!")
    case valor if valor > 0:
        print("Status: Seu saldo está positivo, mas sob controle.")
    case _:
        print("Status: Atenção! Seus gastos superaram/zeraram seu saldo.")
print("-" * 40)










